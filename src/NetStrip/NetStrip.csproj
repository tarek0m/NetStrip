<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0-windows: a versioned TFM (net10.0-windows10.0.x) adds the 25 MB WinRT projection to the output. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- That TFM also set the platform analyzer's floor (CA1416); keep it at Windows 10 2004, as the installer does. -->
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Pointer-sized window-long APIs exist only as arch-specific metadata; x64 and arm64 share the same Ptr signatures. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetStrip.ico</ApplicationIcon>
    <!-- Windows names the cap notification after the exe's FileDescription (from AssemblyTitle); pin it, not the AssemblyName default. -->
    <AssemblyTitle>NetStrip</AssemblyTitle>
    <Product>NetStrip</Product>
    <!-- Working-set budget (spec: ≤ 60 MB): no PGO instrumentation for an app that does a little work once a second. -->
    <TieredPGO>false</TieredPGO>
    <!-- NetStrip is English-only: don't ship the framework's translated resources (about 9 MB in the standalone build). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- Workstation GC sizes gen0 from the CPU's last-level cache (4/5 of it), so on a big desktop CPU the heap walks
         through 25-100 MB of fresh pages between collections and the working set creeps up. Cap it at 4 MB: at this
         app's allocation rate that is a tiny gen0 GC every few minutes. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.19041</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- CsWin32 already adds the project-root NativeMethods.txt; this glob adds folder-level files exactly once. -->
    <AdditionalFiles Include="**\NativeMethods.txt" Exclude="NativeMethods.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window icons (settings window title bar and taskbar button); the exe icon comes from ApplicationIcon. -->
    <Resource Include="Assets\NetStrip.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetStrip.Core\NetStrip.Core.csproj" />
    <ProjectReference Include="..\NetStrip.Shell\NetStrip.Shell.csproj" />
  </ItemGroup>
</Project>
