<Window x:Class="NetStrip.Strip.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetStrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Small, Segoe UI"
        FontSize="12"
        Typography.NumeralAlignment="Tabular"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed">
    <!-- A style of its own, so the strip never takes the Fluent Window style: when the theme loads later (on first
         use of the flyout, menu or tooltip) WPF gives every style-less window that style, which would re-template a
         strip already on screen and detach Root while its menu or tooltip is opening. The strip draws itself. -->
    <Window.Style>
        <Style TargetType="Window" />
    </Window.Style>
    <!-- Width/Height are set from the HWND size in code (FitContentToWindow); top-left so it starts at the HWND origin. -->
    <Border x:Name="Root"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#01000000"
            ToolTipService.InitialShowDelay="600"
            ToolTipService.ShowDuration="8000"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseLeftButtonUp="OnMouseLeftButtonUp"
            MouseMove="OnMouseMove"
            ContextMenuOpening="OnContextMenuOpening"
            ToolTipOpening="OnToolTipOpening">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="SettingsItem" Header="Settings" AutomationProperties.Name="Settings" Click="OnSettingsClick" />
                <MenuItem x:Name="PauseItem" Header="Pause speed display" IsCheckable="True" AutomationProperties.Name="Pause speed display" Click="OnPauseClick" />
                <Separator />
                <MenuItem x:Name="ExitItem" Header="Exit" AutomationProperties.Name="Exit" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid x:Name="Inner" Margin="4,0">
            <!-- Full / floating: arrows left, values right-aligned so changing digits never move anything. -->
            <Grid x:Name="FullLayout" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="UpArrow" Grid.Row="0" Grid.Column="0" Text="↑" Margin="0,0,6,0" />
                <TextBlock x:Name="UpValue" Grid.Row="0" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" />
                <TextBlock x:Name="DownArrow" Grid.Row="1" Grid.Column="0" Text="↓" Margin="0,0,6,0" />
                <TextBlock x:Name="DownValue" Grid.Row="1" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" />
            </Grid>
            <!-- Compact: two short lines in a smaller font ("↑ 209 Kb" over "↓ 0.4 Mb", no "/s"), much narrower than Full.
                 CompactGrid has a fixed width (set in code) so changing digits never rescale it; the Viewbox only shrinks
                 it when the host gives less room than measured (a crowded taskbar). -->
            <Viewbox x:Name="CompactLayout" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid x:Name="CompactGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CompactUpArrow" Grid.Row="0" Grid.Column="0" Text="↑" FontSize="10" Margin="0,0,3,0" />
                    <TextBlock x:Name="CompactUpValue" Grid.Row="0" Grid.Column="1" FontSize="10" TextAlignment="Right" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CompactDownArrow" Grid.Row="1" Grid.Column="0" Text="↓" FontSize="10" Margin="0,0,3,0" />
                    <TextBlock x:Name="CompactDownValue" Grid.Row="1" Grid.Column="1" FontSize="10" TextAlignment="Right" HorizontalAlignment="Right" />
                </Grid>
            </Viewbox>
            <!-- Vertical (side taskbars): upload above download, each unit under its number. VerticalGrid has a fixed
                 width (set in code) so the Viewbox scale stays constant as digits change; it only ever shrinks. -->
            <Viewbox x:Name="VerticalLayout" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="VerticalGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VerticalUpArrow" Grid.Row="0" Grid.Column="0" Text="↑" Margin="0,0,3,0" />
                    <TextBlock x:Name="VerticalUpNumber" Grid.Row="0" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" />
                    <TextBlock x:Name="VerticalUpUnit" Grid.Row="1" Grid.Column="1" FontSize="10" Margin="0,0,0,3"
                               TextAlignment="Right" HorizontalAlignment="Right" />
                    <TextBlock x:Name="VerticalDownArrow" Grid.Row="2" Grid.Column="0" Text="↓" Margin="0,0,3,0" />
                    <TextBlock x:Name="VerticalDownNumber" Grid.Row="2" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" />
                    <TextBlock x:Name="VerticalDownUnit" Grid.Row="3" Grid.Column="1" FontSize="10"
                               TextAlignment="Right" HorizontalAlignment="Right" />
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</Window>
