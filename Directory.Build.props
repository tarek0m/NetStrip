<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <NetStripRepoSlug>tarek0m/NetStrip</NetStripRepoSlug>
    <!-- WPF0001: ThemeMode is experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepoSlug" Value="$(NetStripRepoSlug)" />
  </ItemGroup>
</Project>
